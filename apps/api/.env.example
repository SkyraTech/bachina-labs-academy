# Bachina Labs Academy — API Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string — replace with your local or remote DB URL
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bachina_labs_academy_dev

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Auth (Phase 3) ────────────────────────────────────────────────────────────
# JWT_SECRET=replace-with-a-strong-random-secret
# JWT_EXPIRES_IN=15m
# REFRESH_TOKEN_SECRET=replace-with-another-strong-random-secret
# REFRESH_TOKEN_EXPIRES_IN=7d

# ── Email provider (Phase 5) ──────────────────────────────────────────────────
# EMAIL_PROVIDER=
# EMAIL_FROM=noreply@example.com

# ── Media/Storage provider (Phase 4) ─────────────────────────────────────────
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
