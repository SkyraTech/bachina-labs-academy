# Bachina Labs Academy — API Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env or any file containing real secrets.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Primary database — use a dedicated role, NOT the postgres superuser
# Special characters in passwords must be percent-encoded in URLs (e.g. @ → %40)
DATABASE_URL=postgresql://academy_dev_user:YOUR_PASSWORD@127.0.0.1:5432/bachina_labs_academy?schema=public

# Shadow database for prisma migrate dev — must NOT be the same as DATABASE_URL
SHADOW_DATABASE_URL=postgresql://academy_dev_user:YOUR_PASSWORD@127.0.0.1:5432/bachina_labs_academy_shadow?schema=public

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ── Auth & JWT (Step 2.2.4B) ─────────────────────────────────────────────────
# RS256 Private key: file path (e.g. ./certs/jwt-private.pem) or multiline PEM
JWT_ACCESS_PRIVATE_KEY=./certs/jwt-private.pem
# RS256 Public key: file path (e.g. ./certs/jwt-public.pem) or multiline PEM
JWT_ACCESS_PUBLIC_KEY=./certs/jwt-public.pem
JWT_ACCESS_ISSUER=bachina-labs-academy
JWT_ACCESS_AUDIENCE=bachina-labs-academy-web
JWT_ACCESS_TTL_SECONDS=900

SESSION_DEFAULT_TTL_HOURS=24
SESSION_REMEMBER_TTL_DAYS=30

# Cookie settings: set to true in production HTTPS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Optional cookie domain for cross-subdomain configurations
# AUTH_COOKIE_DOMAIN=

# ── Email (Step 2.2.3 — verification email) ───────────────────────────────────
# Master switch. When false the API uses a no-op provider and sends nothing.
EMAIL_ENABLED=true

# Transport: "smtp" (Mailpit locally, or any SMTP relay) or "resend" (production).
EMAIL_PROVIDER=smtp

# Sender address. Required whenever EMAIL_ENABLED=true.
# Local development sends through Mailpit, which CAPTURES mail for inspection at
# http://localhost:8025 and does NOT deliver to a real inbox.
EMAIL_FROM=hello@skyra-tech.com

# SMTP — defaults target a local Mailpit instance (no auth, no TLS).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Resend — required ONLY when EMAIL_PROVIDER=resend.
# Never commit a real key. Leave unset for local development.
# RESEND_API_KEY=

# Verification link lifetime in minutes. Default 1440 = 24 hours.
EMAIL_VERIFICATION_TTL_MINUTES=1440

# Minimum seconds between verification resends per account. Default 60.
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60

# Origin used to build verification links (no trailing slash).
# Must be the FRONTEND origin, not the API — the user clicks this in a browser.
APP_BASE_URL=http://localhost:4200

# ── Media/Storage provider (Phase 4) ─────────────────────────────────────────
# STORAGE_PROVIDER=
# STORAGE_BUCKET=
