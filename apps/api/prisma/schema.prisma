// Authoritative Prisma schema — apps/api/prisma/schema.prisma
// One schema, one migrations folder, one generated client.
//
// Database: bachina_labs_academy (PostgreSQL 17)
// Role:     academy_dev_user (dedicated dev role — not postgres superuser)
// Phase:    2.2.1 — Users table and Users domain foundation.
//
// DO NOT run prisma migrate deploy on production until ERD is approved for each phase.
// DO NOT use prisma db push as a substitute for tracked migrations.
// DO NOT run prisma migrate reset without explicit project-owner approval.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────────

/**
 * UserRole — controls access level within the Academy.
 * AUTHOR  — default role for all newly registered users.
 * Grants access to author-specific functionality after
 * email verification is confirmed.
 * ADMIN   — elevated role. NEVER assigned automatically from
 * user-supplied input, email address, email domain,
 * OAuth provider claim, or client request.
 * Assigned only through controlled server-side tooling.
 */
enum UserRole {
  AUTHOR
  ADMIN
}

/**
 * UserStatus — coarse lifecycle state of an account.
 * ACTIVE    — default state after registration. The account is usable.
 * Note: ACTIVE does NOT imply email verification is complete.
 * Email verification is tracked separately via emailVerifiedAt.
 * SUSPENDED — account temporarily restricted by an administrator.
 * DISABLED  — account permanently deactivated.
 */
enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

// ── Business models ────────────────────────────────────────────────────────────

/**
 * User — core identity record for every registered Academy account.
 * UUID primary key:
 * Generated by PostgreSQL using gen_random_uuid() (pgcrypto not required
 * on PostgreSQL 13+). @default(dbgenerated("gen_random_uuid()")) causes
 * Prisma to instruct the database to supply the default, meaning INSERT
 * statements that omit the id column will receive a database-generated UUID.
 * This is the finalized primary-key standard for all future business tables.
 * Email uniqueness:
 * Prisma's @unique creates a standard B-tree index (users_email_key),
 * which is case-sensitive under PostgreSQL's default collation.
 * A separate expression index on LOWER(email) (users_email_lower_key)
 * is maintained in the migration SQL to enforce case-insensitive uniqueness.
 * Application code MUST normalize email to lowercase before every insert
 * and lookup. Both indexes coexist safely.
 * Email length:
 * RFC 5321 specifies a maximum of 254 characters for an email address.
 * VARCHAR(254) reflects the actual practical limit (down from the
 * overly conservative 320 used in the initial migration).
 * Timestamp precision:
 * TIMESTAMPTZ(3) = UTC-anchored with millisecond precision.
 * Microsecond precision (6) was reduced to millisecond (3) to align
 * with JavaScript Date precision and standard API serialization.
 * All timestamps remain timezone-aware (WITH TIME ZONE).
 * Password:
 * Nullable because Google-only accounts may not have an Academy password.
 * A null passwordHash MUST NOT be treated as an empty password.
 * Email verification:
 * emailVerifiedAt is null until verified. Account status and email
 * verification are intentionally separate concerns.
 * Future relations (added in later phases — do not define before models exist):
 * profile         UserProfile?
 * articles        Article[]
 * comments        Comment[]
 * uploads         MediaAsset[]
 * resetTokens     PasswordResetToken[]
 * sessions        AuthSession[]
 * emailDeliveries EmailDelivery[]
 */
model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @unique @db.VarChar(254)
  passwordHash    String?    @map("password_hash")
  role            UserRole   @default(AUTHOR)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}

